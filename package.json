{
  "name": "havens-end",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "make:placeholder-ship": "tsx scripts/make-placeholder-ship.ts",
    "duel:balance": "tsx scripts/duel-balance.ts",
    "characters:generate": ".venv/bin/python scripts/generate-characters.py",
    "characters:voxelize": "for c in player imperial merchant pirate; do .venv/bin/python scripts/voxelize-character.py art-source/characters/$c.glb public/models/characters/$c.vox; done"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "simplex-noise": "^4.0.3",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
