{
  // Cloudflare serves the game as static files: whatever `npm run build` puts in dist/.
  // There's no server code, so no Worker script and no Vite plugin.
  "name": "havens-end",
  "compatibility_date": "2026-09-23",
  // Build before every deploy, whatever the dashboard's build command says.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist"
  }
}
