# Copy to .env (gitignored) for the art scripts: `npm run asset` and `npm run characters:generate`.
# The game itself needs none of this. Vite only exposes VITE_* variables to the game,
# so these never reach the bundle.

# Your ComfyUI server. Leave it out to use ComfyUI's own default, http://127.0.0.1:8188.
COMFY_URL=

# A Comfy platform API key, for the paid partner nodes (Nano Banana, FLUX.2, Tripo...):
# https://platform.comfy.org/profile/api-keys
COMFY_API_KEY=
